{
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"prepare": "vp config",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test",
		"build": "vpr --recursive build",
		"pack": "vpr --recursive pack",
		"bump": "bun run scripts/bump.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:dev",
		"@kekkon-nexus/config": "catalog:",
		"@types/bun": "catalog:dev",
		"eslint-plugin-no-relative-import-paths": "catalog:dev",
		"oxfmt": "catalog:dev",
		"oxlint": "catalog:dev",
		"oxlint-tsgolint": "catalog:dev",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"oxfmt": "catalog:dev",
		"oxlint": "catalog:dev",
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.2.0",
		"vitest": "5.0.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "download"
		}
	},
	"catalog": {
		"@kekkon-nexus/config": "^4.0.0",
		"typescript": "^7.0.2",
		"vite-plus": "^1.2.0"
	},
	"catalogs": {
		"dev": {
			"@commitlint/cli": "^21.2.3",
			"@types/bun": "latest",
			"eslint-plugin-no-relative-import-paths": "^1.6.1",
			"oxfmt": ">=0.73.0 <1",
			"oxlint": "^1.88.0",
			"oxlint-tsgolint": "^7.0.2004"
		},
		"stencil": {
			"@stencil/core": "5.0.0-beta.26",
			"@stencil/unplugin": "5.0.0-beta.26"
		},
		"test": {
			"@vitest/browser-webdriverio": "^5.0.0",
			"webdriverio": "^10.0.2"
		}
	}
}
