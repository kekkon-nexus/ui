{
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"prepare": "vp config",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test",
		"build": "vpr --recursive build",
		"pack": "vpr --recursive pack",
		"bump": "bun run scripts/bump.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@kekkon-nexus/config": "^3.4.0",
		"@types/bun": "latest",
		"eslint-plugin-no-relative-import-paths": "^1.6.1",
		"oxfmt": ">=0.72.0 <1",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2",
		"vite-plus": "^1.1.0"
	},
	"overrides": {
		"oxfmt": ">=0.72.0 <1",
		"oxlint": "^1.87.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "download"
		}
	}
}
