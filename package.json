{
	"name": "@kekkon-nexus/ui",
	"version": "0.0.0",
	"description": "",
	"homepage": "https://github.com/kekkon-nexus/ui#readme",
	"bugs": "https://github.com/kekkon-nexus/ui/issues",
	"license": "MIT",
	"author": "Ryan Suhartanto <suhartanto@kekkon.nexus>",
	"repository": "kekkon-nexus/ui",
	"files": [
		"./dist/"
	],
	"type": "module",
	"imports": {
		"#/*": {
			"dev": "./src/*.ts",
			"module-sync": "./dist/*.js",
			"types": "./dist/*.d.ts"
		},
		"#/package.json": "./package.json"
	},
	"exports": {
		".": {
			"dev": "./src/index.ts",
			"module-sync": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"prepare": "vp config",
		"prepack": "vpr build",
		"pack": "bun pm pack",
		"bump": "bun run scripts/bump.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@kekkon-nexus/config": "^3.4.0",
		"@types/bun": "latest",
		"eslint-plugin-no-relative-import-paths": "^1.6.1",
		"oxfmt": ">=0.72.0 <1",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2",
		"vite-plus": "^1.1.0"
	},
	"overrides": {
		"oxfmt": ">=0.72.0 <1",
		"oxlint": "^1.87.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "^24.14.0 || >=26"
	}
}
