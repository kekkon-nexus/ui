{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"experimentalDecorators": true,
		"useDefineForClassFields": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@stencil/core",

		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
