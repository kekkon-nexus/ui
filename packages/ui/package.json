{
	"name": "@kekkon-nexus/ui",
	"version": "0.0.0",
	"description": "",
	"homepage": "https://github.com/kekkon-nexus/ui#readme",
	"bugs": "https://github.com/kekkon-nexus/ui/issues",
	"license": "MIT",
	"author": "Ryan Suhartanto <suhartanto@kekkon.nexus>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kekkon-nexus/ui.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": [
		"./dist/components/*/define.js"
	],
	"exports": {
		"./*": {
			"module-sync": "./dist/components/*/index.js",
			"types": "./dist/components/*/index.d.ts"
		},
		"./*/define": {
			"module-sync": "./dist/components/*/define.js",
			"types": "./dist/components/*/define.d.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepack": "vpr build",
		"build": "vp pack",
		"pack": "vp pm pack --pack-destination ../.."
	},
	"dependencies": {
		"@stencil/core": "catalog:stencil"
	},
	"devDependencies": {
		"@mozilla/readability": "catalog:test",
		"@stencil/unplugin": "catalog:stencil",
		"@types/webidl2": "catalog:webidl",
		"@vitest/browser-webdriverio": "catalog:test",
		"@webref/idl": "catalog:webidl",
		"unplugin": "catalog:",
		"vite-plus": "catalog:",
		"webdriverio": "catalog:test",
		"webidl2": "catalog:webidl"
	},
	"engines": {
		"node": "^24.14.0 || >=26"
	}
}
